      "key": "PAY-118",
      "url": "https://meridian-pay.atlassian.net/browse/PAY-118",
      "type": "Story",
      "status": "Done",
      "priority": "High",
      "summary": "Require Idempotency-Key on charge and refund endpoints",
      "description": "Reject POST /v1/charges and POST /v1/refunds requests that do not carry an Idempotency-Key header (HTTP 400, error code idempotency_key_required).\n\nKeys are stored for 24 hours and replayed responses must be byte-identical.\n\nMotivation: duplicate charges seen on client retries (INC-2026-014).",
      "reporter": "jira-li",
      "assignee": "jira-li",
      "created": "2026-03-04T10:05:00Z",
      "updated": "2026-03-18T16:00:00Z",
      "resolved": "2026-03-18T16:00:00Z",
      "labels": [
        "api",
        "reliability"
      ],
      "components": [
        "payments-service"
      ],
      "comments": [
        {
          "id": "10001",
          "author": "jira-maya",
          "created": "2026-03-05T09:30:00Z",
          "body": "Please make the TTL configurable per environment (default 24h) so staging can use 1h."
        }
      ],
      "changelog": [
        {
          "created": "2026-03-04T12:05:00Z",
          "author": "jira-li",
          "field": "status",
