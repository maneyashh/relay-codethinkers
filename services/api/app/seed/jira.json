      "key": "PAY-122",
      "url": "https://meridian-pay.atlassian.net/browse/PAY-122",
      "type": "Task",
      "status": "Done",
      "priority": "Medium",
      "summary": "Normalize monetary amounts to integer minor units",
      "description": "All monetary amounts in API requests, responses and the ledger are integers in minor units (1999 = USD 19.99). Currency is sent separately as an ISO 4217 code.\n\nAdd CHECK (amount_minor >= 0) to ledger_entries. No floats or decimal strings anywhere in the public API.",
      "reporter": "jira-tomas",
      "assignee": "jira-tomas",
      "created": "2026-03-09T16:10:00Z",
      "updated": "2026-03-25T11:00:00Z",
